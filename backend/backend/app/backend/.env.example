# CLIPFORGE AI - Backend Environment Variables
# Copy to .env and fill values

APP_NAME=CLIPFORGE AI
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=please-generate-a-long-random-string-with-openssl-rand-hex-32

# Database (SQLite for local, Postgres for production)
DATABASE_URL=sqlite:///./clipforge.db
# DATABASE_URL=postgresql+psycopg2://clipforge:password@db:5432/clipforge

# CORS (frontend origin)
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.onrender.com"]

# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional LLM highlight ranking
ENABLE_LLM_HIGHLIGHTS=false
OPENAI_API_KEY=

# Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600

# Redis / Celery (production)
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Limits
FREE_PLAN_MAX_VIDEOS_PER_DAY=3
FREE_PLAN_MAX_DURATION_SECONDS=600
